{
  "manifest_version": 3,
  "name": "Paylens — True-Cost Affordability Copilot",
  "version": "1.0.0",
  "description": "Calculates real take-home affordability, reveals hidden APR markups on No-Cost EMIs, and protects emergency cushions at checkout.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*",
    "https://*.run.app/*",
    "*://*.amazon.in/*",
    "*://*.flipkart.com/*"
  ],
  "background": {
    "service_worker": "background/service_worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.amazon.in/*",
        "*://*.amazon.com/*",
        "*://*.flipkart.com/*",
        "http://localhost:8000/mock-shop/*",
        "http://127.0.0.1:8000/mock-shop/*",
        "https://*.run.app/mock-shop/*",
        "file:///*mock-shop/*",
        "http://localhost:*/mock-shop/*",
        "http://127.0.0.1:*/mock-shop/*"
      ],
      "js": [
        "content/content_loader.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content/card.css",
        "content/content.js",
        "content/card.js",
        "content/adapters/index.js",
        "content/adapters/amazon.js",
        "content/adapters/flipkart.js",
        "content/adapters/generic.js",
        "content/adapters/mock_shop.js",
        "options/options.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Paylens Status & Persona Switcher",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
